#!/usr/bin/env bash
#
# allez - run ALL EZ Tools against a mounted Windows system root.
# Discovers artifacts in their known locations (every user profile included),
# parses everything to CSV, then loads every CSV into one SQLite database.
#
# Usage: allez -s <source> -o <output> [-e] [--no-db]
#   -s        root that corresponds to C:\ (contains Windows/, Users/)
#   -o        output directory (created if needed)
#   -e        extended scan: sweep whole directories (Packages, browser
#             profiles, all of Users) instead of targeting known files.
#             Thorough but MUCH slower on real systems (probes caches too).
#   --no-db   skip building allez.db
set -uo pipefail

EZTOOLS_DIR="${EZTOOLS_DIR:-/opt/eztools}"
SRC="" OUT="" MAKE_DB=1 EXTENDED=0

usage() { sed -n '3,13p' "$0" | sed 's/^# \{0,1\}//'; exit "${1:-0}"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -s) SRC="${2:-}"; shift 2 ;;
    -o) OUT="${2:-}"; shift 2 ;;
    -e|--extended) EXTENDED=1; shift ;;
    --no-db) MAKE_DB=0; shift ;;
    -h|--help|-?) usage ;;
    *) echo "unknown option: $1" >&2; usage 1 ;;
  esac
done
[[ -n "$SRC" && -n "$OUT" ]] || usage 1
[[ -d "$SRC" ]] || { echo "[x] source not found: $SRC" >&2; exit 1; }
SRC="${SRC%/}"
mkdir -p "$OUT"
LOG="$OUT/allez.log"; : > "$LOG"

log()  { printf '[+] %s\n' "$*"; }
warn() { printf '[!] %s\n' "$*" >&2; }

RAN=(); SKIPPED=()
skip() { SKIPPED+=("$1"); }

# Case-insensitive lookups: mounted/copied Windows trees vary in casing.
first_file() { find "$SRC" -maxdepth "$1" -type f -ipath "$SRC/$2" -print -quit 2>/dev/null; }
first_dir()  { find "$SRC" -maxdepth "$1" -type d -ipath "$SRC/$2" -print -quit 2>/dev/null; }

run_tool() { # run_tool <label> <cmd...>
  local label="$1"; shift
  log "$label"
  if "$@" >>"$LOG" 2>&1; then
    RAN+=("$label")
  else
    warn "$label failed (see allez.log)"
  fi
}

recmd_batch() {
  local rebs
  rebs="$(find "$EZTOOLS_DIR/RECmd" -iname '*.reb' 2>/dev/null | sort)"
  grep -im1 kroll <<<"$rebs" || head -n1 <<<"$rebs"
}

log "Source: $SRC"
log "Output: $OUT"
echo

# --- system-wide artifacts ----------------------------------------------
f="$(first_file 1 '$MFT')"
if [[ -n "$f" ]]; then run_tool 'MFTECmd ($MFT)' mftecmd -f "$f" --csv "$OUT/MFTECmd"
else skip 'MFTECmd: no $MFT at the source root'; fi

# $J is often exported with escaped names, e.g. $UsnJrnl%3A$J
f="$(first_file 2 '$Extend/$J')"
[[ -n "$f" ]] || f="$(first_file 2 '$Extend/$UsnJrnl*$J')"
[[ -n "$f" ]] || f="$(first_file 1 '$J')"
if [[ -n "$f" ]]; then run_tool 'MFTECmd ($J)' mftecmd -f "$f" --csv "$OUT/MFTECmd"
else skip 'MFTECmd: no $J ($Extend\$J)'; fi

f="$(first_file 1 '$Boot')"
if [[ -n "$f" ]]; then run_tool 'MFTECmd ($Boot)' mftecmd -f "$f" --csv "$OUT/MFTECmd"
else skip 'MFTECmd: no $Boot at the source root'; fi

# $SDS is exported under names like $Secure_$SDS
f="$(first_file 1 '$SDS')"
[[ -n "$f" ]] || f="$(first_file 2 '$Secure?$SDS')"
if [[ -n "$f" ]]; then run_tool 'MFTECmd ($SDS)' mftecmd -f "$f" --csv "$OUT/MFTECmd"
else skip 'MFTECmd: no $SDS ($Secure)'; fi

d="$(first_dir 4 'Windows/System32/winevt/Logs')"
if [[ -n "$d" ]]; then run_tool 'EvtxECmd (event logs)' evtxecmd -d "$d" --csv "$OUT/EvtxECmd"
else skip 'EvtxECmd: no Windows\System32\winevt\Logs'; fi

d="$(first_dir 2 'Windows/Prefetch')"
if [[ -n "$d" ]]; then run_tool 'PECmd (prefetch)' pecmd -d "$d" --csv "$OUT/PECmd" -q
else skip 'PECmd: no Windows\Prefetch'; fi

f="$(first_file 4 'Windows/appcompat/Programs/Amcache.hve')"
if [[ -n "$f" ]]; then run_tool 'AmcacheParser' amcacheparser -f "$f" -i --csv "$OUT/AmcacheParser"
else skip 'AmcacheParser: no Windows\appcompat\Programs\Amcache.hve'; fi

sys_hive="$(first_file 4 'Windows/System32/config/SYSTEM')"
if [[ -n "$sys_hive" ]]; then run_tool 'AppCompatCacheParser (shimcache)' appcompatcacheparser -f "$sys_hive" --csv "$OUT/AppCompatCacheParser"
else skip 'AppCompatCacheParser: no SYSTEM hive'; fi

batch="$(recmd_batch)"
[[ -n "$batch" ]] || skip 'RECmd: no batch file found under RECmd/BatchExamples'
d="$(first_dir 3 'Windows/System32/config')"
if [[ -n "$d" && -n "$batch" ]]; then
  run_tool 'RECmd (system hives)' recmd -d "$d" --bn "$batch" --csv "$OUT/RECmd"
elif [[ -n "$batch" ]]; then skip 'RECmd: no Windows\System32\config'; fi

# service account profiles (LocalService, NetworkService, custom services)
sproot="$(first_dir 2 'Windows/ServiceProfiles')"
if [[ -n "$sproot" ]]; then
  for sp in "$sproot"/*/; do
    [[ -d "$sp" ]] || continue
    spname="$(basename "$sp")"
    spnt="$(find "$sp" -maxdepth 1 -type f -iname 'ntuser.dat' -print -quit 2>/dev/null)"
    spuc="$(find "$sp" -maxdepth 6 -type f -ipath '*/appdata/local/microsoft/windows/usrclass.dat' -print -quit 2>/dev/null)"
    if [[ -n "$batch" ]]; then
      [[ -n "$spnt" ]] && run_tool "RECmd (NTUSER.DAT, service $spname)" \
        recmd -f "$spnt" --bn "$batch" --csv "$OUT/RECmd/ServiceProfiles_$spname"
      [[ -n "$spuc" ]] && run_tool "RECmd (UsrClass.dat, service $spname)" \
        recmd -f "$spuc" --bn "$batch" --csv "$OUT/RECmd/ServiceProfiles_$spname"
    fi
    if [[ "$EXTENDED" != 1 && ( -n "$spnt" || -n "$spuc" ) ]]; then
      hs="$OUT/.hives/$spname"; mkdir -p "$hs"
      [[ -n "$spnt" ]] && find "$(dirname "$spnt")" -maxdepth 1 -iname 'ntuser.dat*' \
        -exec cp {} "$hs/" \; 2>/dev/null
      [[ -n "$spuc" ]] && find "$(dirname "$spuc")" -maxdepth 1 -iname 'usrclass.dat*' \
        -exec cp {} "$hs/" \; 2>/dev/null
    fi
  done
fi

f="$(first_file 4 'Windows/System32/sru/SRUDB.dat')"
if [[ -n "$f" ]]; then
  soft_hive="$(first_file 4 'Windows/System32/config/SOFTWARE')"
  if [[ -n "$soft_hive" ]]; then run_tool 'SrumECmd (SRUM)' srumecmd -f "$f" -r "$soft_hive" --csv "$OUT/SrumECmd"
  else run_tool 'SrumECmd (SRUM)' srumecmd -f "$f" --csv "$OUT/SrumECmd"; fi
else skip 'SrumECmd: no Windows\System32\sru\SRUDB.dat'; fi

d="$(first_dir 4 'Windows/System32/LogFiles/Sum')"
if [[ -n "$d" ]]; then run_tool 'SumECmd (user access logging)' sumecmd -d "$d" --csv "$OUT/SumECmd"
else skip 'SumECmd: no Windows\System32\LogFiles\Sum'; fi

f="$(first_file 4 'Windows/AppCompat/Programs/RecentFileCache.bcf')"
if [[ -n "$f" ]]; then run_tool 'RecentFileCacheParser' recentfilecacheparser -f "$f" --csv "$OUT/RecentFileCacheParser"
else skip 'RecentFileCacheParser: no RecentFileCache.bcf'; fi

d="$(first_dir 1 '$Recycle.Bin')"
if [[ -n "$d" ]]; then run_tool 'RBCmd (recycle bin)' rbcmd -d "$d" --csv "$OUT/RBCmd" -q
else skip 'RBCmd: no $Recycle.Bin'; fi

d="$(first_dir 4 'ProgramData/Microsoft/Windows/Start Menu')"
if [[ -n "$d" ]]; then run_tool 'LECmd (system start menu)' lecmd -d "$d" --csv "$OUT/LECmd/ProgramData_startmenu" -q
else skip 'LECmd: no ProgramData\Microsoft\Windows\Start Menu'; fi

# --- per-user artifacts --------------------------------------------------
users_dir="$(first_dir 1 'Users')"
if [[ -n "$users_dir" ]]; then
  for u in "$users_dir"/*/; do
    uname="$(basename "$u")"
    case "$uname" in "All Users"|"Default User"|Public|desktop.ini) continue ;; esac
    recent="$(find "$u" -maxdepth 6 -type d -ipath '*/appdata/roaming/microsoft/windows/recent' -print -quit 2>/dev/null)"
    if [[ -n "$recent" ]]; then
      run_tool "LECmd (lnk, user $uname)" lecmd -d "$recent" --csv "$OUT/LECmd/$uname" -q
      run_tool "JLECmd (jump lists, user $uname)" jlecmd -d "$recent" --csv "$OUT/JLECmd/$uname" -q
    fi
    desktop="$(find "$u" -maxdepth 1 -type d -iname 'Desktop' -print -quit 2>/dev/null)"
    if [[ -n "$desktop" ]] && find "$desktop" -maxdepth 1 -iname '*.lnk' -print -quit 2>/dev/null | grep -q .; then
      run_tool "LECmd (desktop lnk, user $uname)" lecmd -d "$desktop" --csv "$OUT/LECmd/${uname}_desktop" -q
    fi
    startmenu="$(find "$u" -maxdepth 6 -type d -ipath '*/appdata/roaming/microsoft/windows/start menu' -print -quit 2>/dev/null)"
    [[ -n "$startmenu" ]] && run_tool "LECmd (start menu, user $uname)" \
      lecmd -d "$startmenu" --csv "$OUT/LECmd/${uname}_startmenu" -q
    # SQLite-based app data with SQLECmd maps (browsers, notifications, store apps)
    if [[ "$EXTENDED" == 1 ]]; then
      # sweep whole directories: thorough, but probes every cache file too
      for entry in 'Chrome:AppData/Local/Google/Chrome/User Data' \
                   'Edge:AppData/Local/Microsoft/Edge/User Data' \
                   'Brave:AppData/Local/BraveSoftware/Brave-Browser/User Data' \
                   'Vivaldi:AppData/Local/Vivaldi/User Data' \
                   'Opera:AppData/Roaming/Opera Software' \
                   'Firefox:AppData/Roaming/Mozilla/Firefox/Profiles' \
                   'Notifications:AppData/Local/Microsoft/Windows/Notifications' \
                   'Packages:AppData/Local/Packages'; do
        blabel="${entry%%:*}"; brel="${entry#*:}"
        bdir="$(find "$u" -maxdepth 6 -type d -ipath "*/${brel}" -print -quit 2>/dev/null)"
        [[ -n "$bdir" ]] && run_tool "SQLECmd ($blabel, user $uname)" \
          sqlecmd -d "$bdir" --csv "$OUT/SQLECmd/$uname"
      done
    else
      # target the known database files directly - seconds instead of minutes
      while IFS= read -r -d '' dbf; do
        run_tool "SQLECmd ($(basename "$dbf"), user $uname)" \
          sqlecmd -f "$dbf" --csv "$OUT/SQLECmd/$uname"
      done < <(find "$u" -maxdepth 9 -type f \( \
          \( \( -iname 'History' -o -iname 'Web Data' \) -ipath '*/user data/*' \) -o \
          \( -iname 'History' -ipath '*/opera*' \) -o \
          -iname 'places.sqlite' -o -iname 'wpndatabase.db' \) -print0 2>/dev/null)
    fi
    while IFS= read -r acdb; do
      run_tool "WxTCmd (timeline, user $uname)" wxtcmd -f "$acdb" --csv "$OUT/WxTCmd/$uname"
    done < <(find "$u" -maxdepth 7 -type f -iname 'ActivitiesCache.db' -ipath '*connecteddevicesplatform*' 2>/dev/null)
    ntuser="$(find "$u" -maxdepth 1 -type f -iname 'NTUSER.DAT' -print -quit 2>/dev/null)"
    usrclass="$(find "$u" -maxdepth 6 -type f -ipath '*/appdata/local/microsoft/windows/usrclass.dat' -print -quit 2>/dev/null)"
    if [[ -n "$batch" ]]; then
      [[ -n "$ntuser" ]] && run_tool "RECmd (NTUSER.DAT, user $uname)" \
        recmd -f "$ntuser" --bn "$batch" --csv "$OUT/RECmd/$uname"
      [[ -n "$usrclass" ]] && run_tool "RECmd (UsrClass.dat, user $uname)" \
        recmd -f "$usrclass" --bn "$batch" --csv "$OUT/RECmd/$uname"
    fi
    # stage hive copies (with transaction logs) for a fast SBECmd pass
    if [[ "$EXTENDED" != 1 && ( -n "$ntuser" || -n "$usrclass" ) ]]; then
      hs="$OUT/.hives/$uname"; mkdir -p "$hs"
      [[ -n "$ntuser" ]] && find "$(dirname "$ntuser")" -maxdepth 1 -iname 'ntuser.dat*' \
        -exec cp {} "$hs/" \; 2>/dev/null
      [[ -n "$usrclass" ]] && find "$(dirname "$usrclass")" -maxdepth 1 -iname 'usrclass.dat*' \
        -exec cp {} "$hs/" \; 2>/dev/null
    fi
  done
  [[ "$EXTENDED" == 1 ]] || skip 'full app-data sweep (Packages, browser profile dirs, whole-Users scan): rerun with -e'
else
  skip 'user artifacts (LECmd/JLECmd/WxTCmd): no Users folder'
fi

# shellbags: staged hive copies (users + service profiles) by default,
# full directory scans with -e
if [[ "$EXTENDED" == 1 ]]; then
  [[ -n "$users_dir" ]] && run_tool 'SBECmd (shellbags, full Users scan)' \
    sbecmd -d "$users_dir" --csv "$OUT/SBECmd"
  [[ -n "$sproot" ]] && run_tool 'SBECmd (shellbags, service profiles)' \
    sbecmd -d "$sproot" --csv "$OUT/SBECmd"
elif [[ -d "$OUT/.hives" ]]; then
  run_tool 'SBECmd (shellbags, staged hives)' sbecmd -d "$OUT/.hives" --csv "$OUT/SBECmd"
  rm -rf "$OUT/.hives"
else
  skip 'SBECmd: no user or service hives found'
fi

# --- build the database --------------------------------------------------
if [[ "$MAKE_DB" == 1 ]]; then
  echo
  db="$OUT/allez.db"
  rm -f "$db"
  imported=0
  while IFS= read -r -d '' csv; do
    base="$(basename "$csv" .csv)"
    tbl="$(printf '%s' "$base" | sed -E 's/^[0-9]{8,}_//' \
      | tr '[:upper:]' '[:lower:]' | tr -c 'a-z0-9' '_' \
      | sed -E 's/_+/_/g; s/^_//; s/_$//; s/^([0-9])/t_\1/;
                s/_[0-9a-f]{8}_[0-9a-f]{4}_[0-9a-f]{4}_[0-9a-f]{4}_[0-9a-f]{12}$//')"
    [[ -n "$tbl" ]] || tbl="table_$imported"
    if [[ -n "$(sqlite3 "$db" "SELECT name FROM sqlite_master WHERE type='table' AND name='$tbl'" 2>/dev/null)" ]]; then
      # same output type from another run/user: append, skipping the header row
      if sqlite3 "$db" ".mode csv" ".import --skip 1 \"$csv\" $tbl" >>"$LOG" 2>&1; then imported=$((imported+1))
      else warn "import failed: $base"; fi
    else
      if sqlite3 "$db" ".mode csv" ".import \"$csv\" $tbl" >>"$LOG" 2>&1; then imported=$((imported+1))
      else warn "import failed: $base"; fi
    fi
  done < <(find "$OUT" -type f -iname '*.csv' -print0)

  # add a username column derived from each row's source path, so per-user
  # filtering is WHERE username = '...' instead of path parsing
  while IFS= read -r t; do
    src=""
    while IFS= read -r col; do
      case "$(printf '%s' "$col" | tr '[:upper:]' '[:lower:]')" in
        sourcefile|hivepath|sourcehive) src="$col"; break ;;
      esac
    done < <(sqlite3 "$db" "SELECT name FROM pragma_table_info('$t')")
    [[ -n "$src" ]] || continue
    norm="replace(\"$src\", char(92), '/')"
    rest="CASE
      WHEN instr(lower($norm), '/users/') > 0
        THEN substr($norm, instr(lower($norm), '/users/') + 7)
      WHEN instr(lower($norm), '/.hives/') > 0
        THEN substr($norm, instr(lower($norm), '/.hives/') + 8)
      WHEN instr(lower($norm), '/serviceprofiles/') > 0
        THEN substr($norm, instr(lower($norm), '/serviceprofiles/') + 17)
      END"
    sqlite3 "$db" "ALTER TABLE \"$t\" ADD COLUMN username TEXT" 2>>"$LOG"
    sqlite3 "$db" "UPDATE \"$t\" SET username = NULLIF(substr(($rest), 1,
        CASE WHEN instr(($rest), '/') > 0 THEN instr(($rest), '/') - 1
             ELSE length(($rest)) END), '')" 2>>"$LOG" \
      || warn "username column failed for table $t"
  done < <(sqlite3 "$db" "SELECT name FROM sqlite_master WHERE type='table'" 2>/dev/null)

  log "Database: $db ($imported CSV files imported)"
  while IFS= read -r t; do
    log "  table $t: $(sqlite3 "$db" "SELECT COUNT(*) FROM \"$t\"") rows"
  done < <(sqlite3 "$db" "SELECT name FROM sqlite_master WHERE type='table' ORDER BY name" 2>/dev/null)
fi

# --- summary --------------------------------------------------------------
echo
log "Ran ${#RAN[@]} parser(s); full tool output in allez.log"
if [[ ${#SKIPPED[@]} -gt 0 ]]; then
  log "Skipped (artifact not present):"
  for s in "${SKIPPED[@]}"; do printf '      %s\n' "$s"; done
fi
[[ ${#RAN[@]} -gt 0 ]] || { warn "nothing was parsed - is $SRC the root of a Windows system drive?"; exit 1; }
